{
  "version": 2,
  "builds": [
    {
      "src": "public/index.php",
      "use": "vercel-php@0.6.0",
      "config": {
        "phpVersion": "8.2"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "\/(css|js|images|storage)\/(.*)",
      "dest": "\/public\/$1\/$2"
    },
    {
      "src": "\/(.*)",
      "dest": "\/public\/index.php"
    }
  ],
  "outputDirectory": "public",
  "build": {
    "env": {
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_URL": "https:\/\/nama-domain-anda.vercel.app",
      "SESSION_DRIVER": "cookie",
      "LOG_CHANNEL": "stderr",
      "CACHE_DRIVER": "array",
      "QUEUE_CONNECTION": "sync",
      "VIEW_COMPILED_PATH": "\/tmp\/views",
      "APP_CONFIG_CACHE": "\/tmp\/config.php",
      "APP_STORAGE": "\/tmp",
      "LOG_LEVEL": "warning",
      "SESSION_LIFETIME": "120"
    }
  }
}

