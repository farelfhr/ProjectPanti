{
  "version": 2,
  "functions": {
    "api/**": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "\/(css|js|images|storage)\/(.*)",
      "dest": "\/public\/$1\/$2"
    },
    {
      "src": "\/(.*)",
      "dest": "\/public\/index.php"
    }
  ],
  "outputDirectory": "public",
  "build": {
    "env": {
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_URL": "https:\/\/nama-domain-anda.vercel.app",
      "SESSION_DRIVER": "cookie",
      "LOG_CHANNEL": "stderr",
      "CACHE_DRIVER": "array",
      "QUEUE_CONNECTION": "sync",
      "VIEW_COMPILED_PATH": "\/tmp\/views",
      "APP_CONFIG_CACHE": "\/tmp\/config.php",
      "APP_STORAGE": "\/tmp",
      "LOG_LEVEL": "warning",
      "SESSION_LIFETIME": "120"
    }
  }
}

