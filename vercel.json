{
  "version": 2,
  "builds": [
    {
      "src": "public/index.php",
      "use": "vercel-php@0.7.2",
      "config": {
        "phpVersion": "8.2"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(css|js|images|storage)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ],
  "outputDirectory": "public",
  "build": {
    "env": {
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_URL": "https://nama-domain-anda.vercel.app",
      "DB_CONNECTION": "pgsql",
      "DB_HOST": "...",
      "DB_PORT": "5432",
      "DB_DATABASE": "...",
      "DB_USERNAME": "...",
      "DB_PASSWORD": "...",
      "SESSION_DRIVER": "cookie"
    }
  }
}

